{
  "name": "3rdSpace-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm -r exec eslint",
    "apps:dev": "pnpm -F \"./apps/*\" run dev",
    "packages:dev": "pnpm -F shared run dev",
    "apps:build": "pnpm -F \"./apps/*\" run build",
    "packages:build": "pnpm -F \"./packages/*\" run build",
    "build": "pnpm lint && pnpm packages:build && pnpm apps:build",
    "preview": "pnpm -F \"./apps/*\" preview",
    "start": "pnpm -r --if-present start"
  },
  "author": "Ken-Sama1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.71.1"
  }
}
