{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=../../.env ./dist/server.js",
    "dev": "concurrently \"rimraf dist\" \"tsc -w \" \"nodemon --env-file=../../.env ./dist/server.js\"",
    "build": "rimraf dist && tsc -b"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "@repo/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
