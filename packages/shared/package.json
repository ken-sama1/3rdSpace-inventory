    "build": "pnpm run clean && pnpm run gen:index && tsc -b"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
