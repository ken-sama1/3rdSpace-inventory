enum InventoryItemUnit {
  KG
  G
  ML
  MG
  PCS
}

model InventoryItem {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  quantity    Int               @default(0)
  unit        InventoryItemUnit @default(G)
  imageUrl    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("inventory_items")
}
